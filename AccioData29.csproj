<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>AccioData29</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Title>Hexagonal Architecture .NET 8 API</Title>
    <Authors>AccioData29</Authors>
    <Description>dotnet new template: REST API con arquitectura hexagonal (Domain, Application, Infrastructure, Shared, Host, API), EF Core, PostgreSQL, AutoMapper, Unit of Work y Generic Repository. Incluye CRUD de ejemplo y tests.</Description>
    <PackageTags>template hexagonal architecture dotnet api csharp postgresql efcore</PackageTags>
    <TargetFramework>net8.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoBuild>true</NoBuild>
  </PropertyGroup>
  <ItemGroup>
    <Content Include=".template.config\**" />
    <Content Include="src\**" />
    <Content Include="Company.ProjectName.sln" />
    <Content Remove="**\bin\**" />
    <Content Remove="**\obj\**" />
  </ItemGroup>
</Project>
